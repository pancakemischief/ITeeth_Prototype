# Azure AI Document Intelligence (Primary Cloud OCR/ICR for ODF scans & PDFs)
AZURE_DOC_INTELLIGENCE_ENDPOINT=
AZURE_DOC_INTELLIGENCE_KEY=
AZURE_DOC_INTELLIGENCE_MODEL_ID=prebuilt-layout

# Local OpenAI whisper.cpp Speech-to-Text (GGML quantized model)
# Presets: tiny.en-q5_1 | tiny.en | base.en-q5_1 | base.en | small.en-q5_1
WHISPER_CPP_MODEL=base.en-q5_1
WHISPER_CPP_USE_GPU=false
WHISPER_CPP_THREADS=2
