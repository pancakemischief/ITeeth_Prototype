# Microsoft Azure AI Document Intelligence (Server-Side Only — Do NOT prefix with VITE_)
# 1. Create a Document Intelligence resource in Azure Portal (https://portal.azure.com)
# 2. Copy Endpoint & Key 1 from "Keys and Endpoint" into a local .env file
AZURE_DOC_INTELLIGENCE_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_DOC_INTELLIGENCE_KEY=your_azure_document_intelligence_api_key_here

# Model ID:
# - Use "prebuilt-layout" right away for OCR/ICR, tables, selection marks, and key-value pairs
# - Replace with your Custom Neural model ID (e.g. "ceu-odf-v1") after training in Document Intelligence Studio
AZURE_DOC_INTELLIGENCE_MODEL_ID=prebuilt-layout

# Optional Supabase Client Configuration (Frontend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
